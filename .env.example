# --- OpenRouter (REQUIRED for real LLM answers + embeddings) ---
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- JWT / Auth (REQUIRED â€” change JWT_SECRET) ---
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- PostgreSQL (auto-started by Docker Compose â€” usually no manual install) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot

# --- MongoDB (auto-started by Docker Compose) ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=chatbot_memory

# --- Neo4j Knowledge Graph (auto-started by Docker Compose) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# --- Vector store (created inside Docker volume â€” no cloud URL) ---
VECTOR_BACKEND=faiss
CHROMA_PERSIST_DIR=/data/chroma
FAISS_INDEX_DIR=/data/faiss
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Internal service URLs (Docker network â€” leave as-is when using Compose) ---
AUTH_SERVICE_URL=http://auth-service:8001
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8002
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8003
MEMORY_SERVICE_URL=http://memory-service:8004

# --- Frontend ---
NEXT_PUBLIC_API_BASE=/api
NODE_ENV=production

# --- Dynamic tools / Web search ---
# Optional: https://tavily.com â€” better search quality for weather/stocks/news
# If empty, DuckDuckGo HTML/instant-answer fallback is used (no key required)
TAVILY_API_KEY=
TOOL_HTTP_TIMEOUT_SECONDS=20
TOOL_ALLOWED_HOSTS=example.com

# --- Internal ---
INTERNAL_SERVICE_KEY=dev-internal-key

LOG_LEVEL=INFO
PROJECT_TITLE=Memory-Augmented Chatbot with Knowledge Graph and Hybrid RAG System
